rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isVerified() { return request.auth.token.email_verified == true; }

    // --- Blueprints ---
    function isValidProfile(data) {
      return data.role in ['traveler', 'vendor', 'admin']
          && (data.get('full_name', '') is string && data.get('full_name', '').size() <= 100)
          && (data.get('created_at', request.time) == request.time || data.get('created_at', request.time) == resource.data.created_at)
          && data.keys().hasAll(['role']);
    }

    function isValidVendorProfile(data) {
      return data.user_id == request.auth.uid
          && data.business_name is string && data.business_name.size() > 0 && data.business_name.size() <= 200
          && data.business_type in ['stays', 'transport', 'adventure', 'tour_agent', 'restaurant', 'other']
          && (data.get('created_at', request.time) == request.time || data.get('created_at', request.time) == resource.data.created_at)
          && data.keys().hasAll(['user_id', 'business_name', 'business_type']);
    }

    function isValidListing(data) {
      return data.vendor_id is string && isValidId(data.vendor_id)
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.base_price is number && data.base_price >= 0
          && data.price_unit in ['per_night', 'per_person', 'per_day', 'fixed']
          && (data.get('created_at', request.time) == request.time || data.get('created_at', request.time) == resource.data.created_at);
    }

    function isValidBooking(data) {
      return data.listing_id is string && isValidId(data.listing_id)
          && data.traveler_id == request.auth.uid
          && data.vendor_id is string && isValidId(data.vendor_id)
          && data.status in ['pending', 'confirmed', 'in_progress', 'completed', 'cancelled']
          && data.created_at == request.time;
    }

    // --- Collection Matches ---

    match /profiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.role == 'vendor'; // Vendors can explore profiles for contact
      allow create: if isOwner(userId) && isValidProfile(incoming());
      allow update: if isOwner(userId) && isValidProfile(incoming()) && incoming().role == existing().role; 
    }

    match /vendor_profiles/{vendorId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidVendorProfile(incoming());
      allow update: if isSignedIn() && existing().user_id == request.auth.uid && isValidVendorProfile(incoming())
                   && incoming().user_id == existing().user_id;
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidListing(incoming());
      allow update: if isSignedIn() && isValidListing(incoming()) 
                   && (get(/databases/$(database)/documents/vendor_profiles/$(existing().vendor_id)).data.user_id == request.auth.uid)
                   && incoming().vendor_id == existing().vendor_id;
      allow delete: if isSignedIn() && (get(/databases/$(database)/documents/vendor_profiles/$(existing().vendor_id)).data.user_id == request.auth.uid);
    }

    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.traveler_id == request.auth.uid || resource.data.vendor_id == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.traveler_id == request.auth.uid || resource.data.vendor_id == request.auth.uid);
      allow create: if isSignedIn() && isValidBooking(incoming()) && exists(/databases/$(database)/documents/listings/$(incoming().listing_id));
      allow update: if isSignedIn() && (existing().traveler_id == request.auth.uid || existing().vendor_id == request.auth.uid)
                   && isValidBooking(incoming())
                   && incoming().traveler_id == existing().traveler_id
                   && incoming().vendor_id == existing().vendor_id;
    }

    match /test/connection {
      allow get: if true;
    }
  }
}
