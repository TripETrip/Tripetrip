{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "User profile extending Auth",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["traveler", "vendor", "admin"] },
        "full_name": { "type": "string" },
        "avatar_url": { "type": "string" },
        "phone": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "created_at"]
    },
    "VendorProfile": {
      "title": "Vendor Profile",
      "description": "Business details for vendors",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "business_name": { "type": "string" },
        "business_type": { "type": "string", "enum": ["stays", "transport", "adventure", "tour_agent", "restaurant", "other"] },
        "slug": { "type": "string" },
        "custom_website": { "type": "string" },
        "description": { "type": "string" },
        "logo_url": { "type": "string" },
        "banner_url": { "type": "string" },
        "social_links": { 
          "type": "object", 
          "properties": {
            "instagram": { "type": "string" },
            "facebook": { "type": "string" },
            "whatsapp": { "type": "string" }
          }
        },
        "address": { "type": "string" },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "business_name", "business_type", "slug", "created_at"]
    },
    "Listing": {
      "title": "Listing",
      "description": "Travel service listing",
      "type": "object",
      "properties": {
        "vendor_id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "base_price": { "type": "number" },
        "price_unit": { "type": "string", "enum": ["per_night", "per_person", "per_day", "fixed"] },
        "max_capacity": { "type": "integer" },
        "images": { "type": "array", "items": { "type": "string" } },
        "amenities": { "type": "array", "items": { "type": "string" } },
        "location": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["vendor_id", "title", "base_price", "price_unit", "created_at"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Reservation record",
      "type": "object",
      "properties": {
        "listing_id": { "type": "string" },
        "traveler_id": { "type": "string" },
        "vendor_id": { "type": "string" },
        "check_in": { "type": "string", "format": "date-time" },
        "check_out": { "type": "string", "format": "date-time" },
        "guest_count": { "type": "integer" },
        "total_price": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "in_progress", "completed", "cancelled"] },
        "payment_status": { "type": "string", "enum": ["pending", "escrowed", "released", "refunded"] },
        "razorpay_order_id": { "type": "string" },
        "razorpay_payment_id": { "type": "string" },
        "special_requests": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["listing_id", "traveler_id", "vendor_id", "check_in", "guest_count", "total_price", "created_at"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "Profile",
      "description": "User public and role profile"
    },
    "/vendor_profiles/{vendorId}": {
      "schema": "VendorProfile",
      "description": "Detailed business profile for vendors"
    },
    "/listings/{listingId}": {
      "schema": "Listing",
      "description": "Available travel services"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Reservations between travelers and vendors"
    },
    "/test/connection": {
      "schema": { "type": "object", "properties": { "status": { "type": "string" } } },
      "description": "Connection test document"
    }
  }
}
